# Chrome Extension OAuth client ID from Google Cloud Console.
WXT_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Chrome Web Store public key used to keep the development extension ID stable.
WXT_EXTENSION_PUBLIC_KEY=your-extension-public-key

# Optional future LeetPet account API. The current milestone stores the Google
# profile locally and never persists the Google access token.
WXT_PUBLIC_API_BASE_URL=

